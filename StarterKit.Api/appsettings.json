{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=starterkit;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "StarterKit",
    "Audience": "StarterKit.Clients",
    "ExpiresMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenReuseLeewaySeconds": 10
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  }
}
