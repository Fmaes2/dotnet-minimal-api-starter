@host = http://localhost:8080

### Check that the API is up
GET {{host}}/health

### Register user 1 (returns 400 if the email already exists, which is fine on later runs)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Test1234!"
}

### Login as user 1 (stores the token for the requests below)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Test1234!"
}

### Who am I (returns the authenticated user)
GET {{host}}/api/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### Without a token: should return 401
GET {{host}}/api/products

### Create a product as user 1 (its id is reused by the requests below)
# @name createProduct
POST {{host}}/api/products
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "Test product",
  "description": "First test",
  "price": 9.99
}

### List products (paginated)
GET {{host}}/api/products?page=1&pageSize=10
Authorization: Bearer {{login.response.body.$.token}}

### Get the product by id
GET {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

### Update the product as its owner (should return 200)
PUT {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "Updated product",
  "description": "New description",
  "price": 19.99
}

### Validation: empty name and negative price (should return 400)
POST {{host}}/api/products
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "",
  "price": -5
}

### Register user 2 (returns 400 if the email already exists, which is fine on later runs)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "Test1234!"
}

### Login as user 2
# @name login2
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "Test1234!"
}

### User 2 tries to update user 1's product (should return 403)
PUT {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login2.response.body.$.token}}
Content-Type: application/json

{
  "name": "Hacked",
  "description": "Should not be saved",
  "price": 1
}

### User 2 tries to delete user 1's product (should return 403)
DELETE {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login2.response.body.$.token}}

### Delete the product as its owner (should return 204)
DELETE {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

### The product no longer exists (should return 404)
GET {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}